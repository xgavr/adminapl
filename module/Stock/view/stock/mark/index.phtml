        function authKey(dialog){
            $.get( "/mark/auth-key/", function(data){
                
                if (data.error_message){
                    dialog.find('.dialog-body').html(data.error_message);
                } else {                                  
                    setUuid(data.uuid);
                    setMarkData(data.data);                
                    dialog.find('.dialog-body').html('2. Подпишите строку: ' + getMarkData());
                    dialog.find('#bootbox-prompt-textarea').val('');
                }    
            });        
        }
        
        function tokenData(dialog){
            // 1. Получаем сырой текст из textarea вместе с PEM-заголовками
            let rawKey = dialog.find('#bootbox-prompt-textarea').val();

            // 2. Отправляем POST-запрос на сервер
            $.post("/mark/token-data/", { data: rawKey, uuid: getUuid() }, function(data){
                // Тут обрабатываем ответ от сервера (например, выводим токен)
//                console.log("Ответ сервера:", data);

                // Если нужно записать полученный токен обратно в textarea:
                 dialog.find('#bootbox-prompt-textarea').val(data.token);
                 
            }, "json"); // Укажите "json", если сервер возвращает JSON-ответ

            return false; // Не закрываем диалог автоматически, пока ждем ответ        
        }
        
        function saveToken(dialog){
            // 1. Получаем сырой текст из textarea вместе с PEM-заголовками
            let token = dialog.find('#bootbox-prompt-textarea').val();

            // 2. Отправляем POST-запрос на сервер
            $.post("/mark/save-token/", { data: token}, function(data){
                // Тут обрабатываем ответ от сервера (например, выводим токен)
                console.log("Ответ сервера:", data);

                // Если нужно записать полученный токен обратно в textarea:
//                 dialog.find('#bootbox-prompt-textarea').val(data.token);
                 
            }, "json"); // Укажите "json", если сервер возвращает JSON-ответ

            return false; // Не закрываем диалог автоматически, пока ждем ответ        
        }
        
        // Функция для проверки, установлен и запущен ли плагин КриптоПро
        function checkCadesPlugin() {
            return new Promise((resolve) => {
                // Проверяем, загрузился ли базовый скрипт API
                if (typeof cadesplugin === 'undefined') {
                    showPluginInstallAlert("Скрипт cadesplugin_api.js не загружен. Проверьте подключение к интернету или путь к файлу.");
                    return resolve(false);
                }

                // Ждем инициализации самого плагина в браузере
                cadesplugin.then(
                    function () {
                        // Плагин успешно загружен и готов к работе
                        resolve(true);
                    },
                    function (error) {
                        // Плагин или расширение не установлены/не запущены
                        showPluginInstallAlert("КриптоПро ЭЦП Browser plug-in не обнаружен или не запущен в вашем браузере.");
                        resolve(false);
                    }
                );
            });
        }  
        
        // Красивое окно со ссылками на скачивание
        function showPluginInstallAlert(message) {
            bootbox.alert({
                title: "<span class='text-danger'><i class='fa fa-exclamation-triangle'></i> КриптоПро не настроен</span>",
                message: `
                    <p><strong>${message}</strong></p>
                    <p>Для подписания строк маркировки на вашем компьютере должно быть установлено рабочее окружение КриптоПро:</p>
                    <ol>
                        <li>Убедитесь, что установлена программа <strong>КриптоПро CSP</strong> (версии 5.0 и выше).</li>
                        <li>Скачайте и установите локальный модуль <a href="https://cryptopro.ru" target="_blank" class="alert-link">КриптоПро ЭЦП Browser plug-in</a>.</li>
                        <li>Установите расширение для вашего браузера (например, <a href="https://google.com" target="_blank" class="alert-link">CryptoPro Extension для Chrome / Яндекс.Браузера</a>).</li>
                        <li>Перезапустите браузер после установки.</li>
                    </ol>
                `,
                size: "large"
            });
        }        
        
        // Основная функция подписания, вызываемая из Bootbox-диалога
        async function signMarkingData(dialog) {
            // 1. Сперва проверяем плагин. Если проверка не прошла — прерываем выполнение
            let isPluginReady = await checkCadesPlugin();
            if (!isPluginReady) return;

            try {
                // 2. Получаем исходную строку аутентификации от Честного Знака
                let dataToSign = getMarkData(); 
                if (!dataToSign) {
                    bootbox.alert("Ошибка: Строка для подписания пуста или еще не получена в Шаге 1.");
                    return;
                }

                // Переводим строку в Base64 (плагин КриптоПро требует именно Base64 для бинарной точности ГОСТ)
                let dataInBase64 = btoa(unescape(encodeURIComponent(dataToSign)));

                // Отображаем индикатор загрузки, пока пользователь выбирает сертификат / идет подпись
                let loadingDialog = bootbox.dialog({ 
                    message: '<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Инициализация хранилища сертификатов...</div>', 
                    closeButton: false 
                });

                // 3. Открываем хранилище "Личные" сертификаты пользователя
                let oStore = await cadesplugin.CreateObjectAsync("CAdESCOM.Store");
                await oStore.Open(
                    cadesplugin.CAPICOM_CURRENT_USER_STORE, 
                    cadesplugin.CAPICOM_MY_STORE, 
                    cadesplugin.CAPICOM_STORE_OPEN_MAXIMUM_ALLOWED
                );

                let oCertificates = await oStore.Certificates;

                // Фильтруем только действующие сертификаты
                let oValidCertificates = await oCertificates.Find(cadesplugin.CAPICOM_CERTIFICATE_FIND_TIME_VALID);
                let count = await oValidCertificates.Count;

                if (count === 0) {
                    loadingDialog.modal('hide');
                    bootbox.alert("В хранилище 'Личные' (My) не найдено действующих сертификатов КЭП.");
                    await oStore.Close();
                    return;
                }

                // Выбираем самый первый подходящий сертификат (для автоматизации)
                let oCertificate = await oValidCertificates.Item(1); 

                // 4. Настраиваем объект подписания (Signer)
                let oSigner = await cadesplugin.CreateObjectAsync("CAdESCOM.CPSigner");
                await oSigner.propset_Certificate(oCertificate);
                // Включаем всю цепочку сертификатов (требование Честного Знака для CADES_BES)
                await oSigner.propset_Options(cadesplugin.CAPICOM_CERTIFICATE_INCLUDE_WHOLE_CHAIN);

                // 5. Создаем объект подписи
                let oSignedData = await cadesplugin.CreateObjectAsync("CAdESCOM.CadesSignedData");
                await oSignedData.propset_ContentEncoding(cadesplugin.CADESCOM_BASE64_TO_BINARY);
                await oSignedData.propset_Content(dataInBase64);

                // Изменяем текст в лоадере перед вызовом самого окна КриптоПро
                loadingDialog.find('.modal-body').html('<div class="text-center"><i class="fa fa-spin fa-spinner"></i> Подписание строки. Подтвердите действие в окне КриптоПро...</div>');

                // Формируем ПРИСОЕДИНЕННУЮ подпись (isDetached = false)
                let isDetached = false; 
                let signature = await oSignedData.SignCades(oSigner, cadesplugin.CADESCOM_CADES_BES, isDetached);

                // Закрываем лоадер, подпись готова
                loadingDialog.modal('hide'); 

                // 6. Форматируем результат в PEM-формат (имитация certutil -encode)
                let formattedPem = "-----BEGIN CERTIFICATE-----\n" + 
                                   signature.match(/.{1,64}/g).join("\n") + 
                                   "\n-----END CERTIFICATE-----";

                // 7. Помещаем готовую закодированную подпись в вашу textarea основного диалога
                dialog.find('#bootbox-prompt-textarea').val(formattedPem);

                // Информируем пользователя об успехе
                bootbox.alert({
                    message: "Строка успешно подписана! Данные в текстовом поле обновлены.",
                    size: "small"
                });

                // Закрываем хранилище
                await oStore.Close();

            } catch (err) {
                // В случае ошибки (например, пользователь нажал "Отмена" в окне ввода пин-кода контейнера)
                bootbox.hideAll(); // Закрываем все открытые окна (включая лоадер)
                bootbox.alert("Ошибка при подписании: " + (err.message || cadesplugin.getLastError(err)));
            }
        }
        
        function signTokenDialog(){
            
            let dialog = bootbox.dialog({
                title: 'Получить токен доступа к маркировке',
                message: `<p class="dialog-body">1. Нажмите Получить строку и UUID</p>            
                            <div class="form-group">
                                <textarea id="bootbox-prompt-textarea" class="form-control" rows="15" style="resize: vertical;"></textarea>
